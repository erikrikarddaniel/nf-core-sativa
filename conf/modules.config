/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'IQTREE' {
        // Pin the ML search seed: without it, IQTREE's stochastic tree search produces
        // a different topology/branch lengths on every run of the same input, which
        // then cascades into different SATIVALOOSPLIT/EPANG_PLACE/SATIVASCORE output
        // on every run -- fine for real analyses, but makes nf-test snapshots unstable.
        // A fixed seed alone isn't enough: IQTREE's own docs note multi-threaded search
        // isn't perfectly reproducible even with one, because thread scheduling affects
        // the search trajectory. The module's script hardcodes "-nt AUTO -ntmax
        // $task.cpus" after ext.args, so ext.args can't override -nt directly; force
        // single-threaded search (acceptable for this pipeline's small test dataset,
        // but a real slowdown on large ones -- worth revisiting if IQTREE's search
        // step becomes a bottleneck).
        cpus     = 1
        // Restrict ModelFinder to the GTR family: EPA-ng's --model only understands
        // RAxML-NG-style model names, but IQTREE's ModelFinder can pick from a much
        // broader space (e.g. picked "K2P" for the real GTDB archaea dataset), and most
        // of those names have no equivalent EPA-ng understands, aborting placement with
        // "Invalid model name". GTR is a strict superset of the simpler models
        // (K2P/HKY/etc. are all constrained special cases of it) and is the one
        // substitution-model naming convention both tools share, so this costs a little
        // ModelFinder precision but guarantees every dataset stays placeable.
        ext.args = '-seed 42 -mset GTR'
    }

    withName: 'EPANG_PLACE' {
        // meta.model is the IQTREE-derived model string folded in by the SATIVA
        // subworkflow; epa-ng aborts if run without an explicit --model.
        //
        // --filter-max/--filter-min-lwr override epa-ng's defaults (7 placements,
        // 0.01 minimum LWR), which silently discard most of the placement-probability
        // mass per query (observed: default settings reported placements summing to
        // ~10% of total likelihood weight for a genuinely misplaced sequence, vs ~100%
        // with these relaxed). SATIVASCORE's per-rank confidence is a weighted vote
        // across all candidate placements, so truncating the candidate list biases
        // confidence sharply downward and causes real mislabels to go undetected.
        ext.args = { "--model \"${meta.model}\" --filter-max 100000 --filter-min-lwr 0.0000001" }
    }

    withName: 'RAXTAX' {
        // --skip-exact-matches: without it, a query's exact self-match in the database
        // (query and database are the same file for this pipeline's self-classification
        // prefilter) short-circuits to confidence 1.0 for that record's own declared
        // (possibly wrong) lineage, defeating the whole point of the check.
        ext.args = '--skip-exact-matches'
    }

    withName: 'RAXTAXFILTER' {
        ext.args = { "--filter-rank ${params.raxtax_filter_rank}" }
    }

    withName: 'HMMER_HMMALIGN' {
        // Trims each sequence's own unaligned terminal tails. NOT what restricts
        // output to match-state columns -- that's HMMER_ESLALIMASK below (--trim
        // was mistakenly assumed to do this; confirmed via `hmmalign -h` that it
        // only trims per-sequence tails, not alignment columns).
        ext.args = '--trim'
    }

    withName: 'HMMER_ESLALIMASK' {
        // Mask down to the profile's own match-state columns (the alignment's
        // #=GC RF annotation), discarding insert-state columns -- those exist only
        // to accommodate specific sequences' own insertions, padding every other
        // sequence with extra gap columns there and otherwise deflating GAPFILTER's
        // non-gap-proportion metric for genuinely full-length sequences.
        ext.args = '--rf-is-mask'
    }

    withName: 'HMMER_ESLREFORMAT' {
        // Must be 'afa' (aligned FASTA, keeps gap columns), not 'fasta' (unaligned
        // output, strips them) -- see esl-reformat's own format table (esl-reformat -h).
        ext.args = 'afa'
    }

    withName: 'GAPFILTER' {
        ext.args = { "--min-nongap ${params.min_nongap}" }
    }

    withName: 'PROFILECOVER' {
        ext.args = { "--min-coverage ${params.min_profile_cover}" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
