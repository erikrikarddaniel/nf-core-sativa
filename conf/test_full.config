/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/taxmarker -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Largest real dataset currently available (121 GTDB archaeal 16S sequences); stand-in
    // until a genuinely full-scale dataset is curated.
    taxonomy  = params.pipelines_testdata_base_path + '/taxmarker/testdata/gtdb_archaea_16s.tax'
    sequences = params.pipelines_testdata_base_path + '/taxmarker/testdata/gtdb_archaea_16s_aligned.fasta'
}
