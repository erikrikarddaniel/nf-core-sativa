/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests with a Clustal-formatted alignment
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same dataset as the default test profile, but exercises the Clustal branch of the
    EMBOSS_SEQRET alignment-format normalisation step.

    Use as follows:
        nextflow run nf-core/sativa -profile test_clustal,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Clustal test profile'
    config_profile_description = 'Minimal test dataset (Clustal alignment) to check pipeline function'

    // Input data
    taxonomy  = params.pipelines_testdata_base_path + '/sativa/testdata/sativa_test.tax'
    alignment = params.pipelines_testdata_base_path + '/sativa/testdata/sativa_test.aln'
}
