nextflow_process {

    name "Test Process SATIVASCORE"
    script "../main.nf"
    process "SATIVASCORE"

    tag "modules"
    tag "modules_local"
    tag "sativa"
    tag "sativa/sativascore"

    test("sativa - 5 real jplace placements, weighted across all candidates") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sativa_score_test' ],
                    [
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UnpCCeti.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UxjAloci.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UyvCanif.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_DupSeq01.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_DupSeq02.jplace.gz', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test.tax', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success

            def mislabels = path(process.out.mislabels[0][1]).text
            def summary   = path(process.out.summary[0][1]).text

            assertAll(
                // DupSeq01/DupSeq02 are an intentional swapped-label pair; almost all
                // placement weight lands on the wrong one, so both are flagged with
                // high confidence (~0.98).
                { assert mislabels.contains('DupSeq01') },
                { assert mislabels.contains('DupSeq02') },
                // UxjAloci is placed within Fusobacteria (not its declared Firmicutes)
                // by ~99% of the total placement weight once spread across every
                // candidate edge -- this is the case that a single-best-edge estimate
                // (LWR ~0.03-0.09 on any individual edge) would miss entirely, but
                // aggregating the full candidate distribution recovers it, matching
                // the real SATIVA tool's own mislabels output for this dataset
                // (reported: Phylum, confidence 1.000).
                { assert mislabels.contains('UxjAloci') },
                // UnpCCeti is a real mislabel too (real tool: Genus, confidence 0.694);
                // only visible once weighted across all candidates, not just the best edge.
                { assert mislabels.contains('UnpCCeti') },
                // UyvCanif is genuinely well-placed: its genus matches the declared
                // taxonomy, and the only divergence is a low-confidence (~0.18) species
                // guess among several near-identical congeners -- correctly suppressed
                // by the default --min-lwr cutoff, not reported as a mislabel.
                { assert !mislabels.contains('UyvCanif') },
                { assert summary.contains('sequences scored: 5') },
                { assert summary.contains('putative mislabels: 4') },
                { assert snapshot(mislabels, summary).match("mislabels_and_summary") },
                { assert process.out.versions }
            )
        }

    }

    test("sativa - 5 real jplace placements - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'sativa_score_test' ],
                    [
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UnpCCeti.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UxjAloci.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_UyvCanif.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_DupSeq01.jplace.gz', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test_DupSeq02.jplace.gz', checkIfExists: true),
                    ],
                    file(params.pipelines_testdata_base_path + '/sativa/testdata/sativa_score_test.tax', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
