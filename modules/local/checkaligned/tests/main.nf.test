nextflow_process {

    name "Test Process CHECKALIGNED"
    script "../main.nf"
    process "CHECKALIGNED"

    tag "modules"
    tag "modules_local"
    tag "taxmarker"
    tag "taxmarker/checkaligned"

    test("taxmarker - equal-length fasta is aligned") {

        when {
            process {
                """
                input[0] = [
                    [ id:'sativa_loo_test' ],
                    file(params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_loo_test.fasta', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.aligned.size() == 1 },
                { assert process.out.unaligned.size() == 0 },
                { assert path(process.out.aligned[0][1]).text.contains('>SeqA') },
                { assert process.out.versions }
            )
        }

    }

    test("taxmarker - varying-length fasta is unaligned") {

        when {
            process {
                """
                input[0] = [
                    [ id:'checkaligned_test' ],
                    file(params.pipelines_testdata_base_path + 'taxmarker/testdata/checkaligned_test_unaligned.fasta', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert process.out.aligned.size() == 0 },
                { assert process.out.unaligned.size() == 1 },
                { assert path(process.out.unaligned[0][1]).text.contains('>SeqA') },
                { assert process.out.versions }
            )
        }

    }

    test("taxmarker - equal-length fasta is aligned - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'sativa_loo_test' ],
                    file(params.pipelines_testdata_base_path + 'taxmarker/testdata/sativa_loo_test.fasta', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
