nextflow_process {

    name "Test Process RAXTAX"
    script "../main.nf"
    process "RAXTAX"

    tag "modules"
    tag "modules_local"
    tag "taxmarker"
    tag "taxmarker/raxtax"

    test("taxmarker - self-classification, one mislabelled sequence") {

        when {
            process {
                """
                input[0] = [
                    [ id:'raxtax_test' ],
                    file(params.pipelines_testdata_base_path + '/sativa/testdata/raxtax_test.fasta', checkIfExists: true),
                ]
                input[1] = file(params.pipelines_testdata_base_path + '/sativa/testdata/raxtax_test.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def out = path(process.out.out[0][1]).text

            assertAll(
                // SeqMisl is declared PhylumB but built from PhylumA content: its best
                // (and only, --skip-exact-matches drops the trivial self-hit) raxtax hit
                // must point back to the PhylumA lineage.
                { assert out =~ /SeqMisl[^\t]*\tBacteria,PhylumA,ClassA,GenusA,SpeciesA/ },
                // SeqB1/SeqB2 are genuinely consistent: best hit stays within PhylumB.
                { assert out =~ /SeqB1[^\t]*\tBacteria,PhylumB,ClassB,GenusB,SpeciesB/ },
                { assert out =~ /SeqB2[^\t]*\tBacteria,PhylumB,ClassB,GenusB,SpeciesB/ },
                { assert snapshot(out).match("raxtax_out") },
                { assert process.out.versions }
            )
        }

    }

    test("taxmarker - self-classification, one mislabelled sequence - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'raxtax_test' ],
                    file(params.pipelines_testdata_base_path + '/sativa/testdata/raxtax_test.fasta', checkIfExists: true),
                ]
                input[1] = file(params.pipelines_testdata_base_path + '/sativa/testdata/raxtax_test.fasta', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
